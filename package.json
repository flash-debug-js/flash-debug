{
  "name": "flash-debug-monorepo",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "eslint --cache",
    "release": "bumpp -r",
    "dev": "pnpm --parallel --filter @flash-debug/server --filter @flash-debug/inspector run dev",
    "dev:silkworm": "pnpm --filter @flash-debug/silkworm dev"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "defu": "^6.1.7",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^5.1.0"
  }
}
