{
  "name": "@flash-debug/server",
  "type": "module",
  "version": "0.2.3",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/flash-debug-js/flash-debug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-debug-js/flash-debug.git"
  },
  "bugs": {
    "url": "https://github.com/flash-debug-js/flash-debug/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "nitro.config.ts",
    "server"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "nitro dev --host 127.0.0.1 --port 4518",
    "build": "unbuild",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flash-debug/config": "workspace:*",
    "@flash-debug/inspector": "workspace:*",
    "@flash-debug/types": "workspace:*",
    "nitro": "3.0.261103-rc"
  }
}
