{
  "name": "@flash-debug/silkworm",
  "type": "module",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "pnpm --filter @flash-debug/config build",
    "dev": "esno scripts/dev.ts",
    "build": "pnpm run build:ui && nitro build",
    "build:ui": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@flash-debug/config": "workspace:*",
    "@flash-debug/types": "workspace:*",
    "nitro": "3.0.261103-rc",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "esno": "^4.8.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
