{
  "name": "@flash-debug/silkworm",
  "type": "module",
  "version": "0.3.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/flash-debug-js/flash-debug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-debug-js/flash-debug.git"
  },
  "bugs": {
    "url": "https://github.com/flash-debug-js/flash-debug/issues"
  },
  "files": [
    "dist",
    ".output",
    "index.html",
    "nitro.config.ts",
    "public",
    "scripts",
    "server",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "scripts": {
    "predev": "pnpm --filter @flash-debug/config build",
    "dev": "esno scripts/dev.ts",
    "build": "pnpm run build:ui && nitro build",
    "build:ui": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@flash-debug/config": "workspace:*",
    "@flash-debug/types": "workspace:*",
    "nitro": "3.0.261103-rc",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "esno": "^4.8.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
